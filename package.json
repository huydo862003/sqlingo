{
	"private": true,
	"packageManager": "pnpm@10.26.1",
	"scripts": {
		"test": "pnpm --filter sqlingo run test",
		"build": "pnpm --filter sqlingo run build",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"changeset": "changeset",
		"version": "changeset version",
		"release": "pnpm --filter sqlingo run build && changeset publish && git push --follow-tags",
		"doc": "pnpm --filter sqlingo-homepage run build"
	},
	"devDependencies": {
		"@changesets/cli": "^2.31.1",
		"@hdnax/nuclint": "^0.17.5",
		"eslint": "^9.39.5",
