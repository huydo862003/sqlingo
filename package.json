{
	"private": true,
	"packageManager": "pnpm@12.3.4",
	"scripts": {
		"test": "pnpm --filter sqlingo run test",
		"build": "pnpm --filter sqlingo run build",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"changeset": "changeset",
		"version": "changeset version",
		"release": "pnpm --filter sqlingo run build && changeset publish && git push --follow-tags",
		"doc": "pnpm --filter sqlingo-homepage run build"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@hdnax/nuclint": "^0.17.5",
		"eslint": "^10.11.0",
		"eslint-plugin-unicorn": "^74.0.0",
		"eslint-plugin-vue": "^10.11.1",
		"jiti": "2.7.0",
		"tailwindcss": "^4.3.3",
		"vue-tsc": "^3.3.11"
	}
}
